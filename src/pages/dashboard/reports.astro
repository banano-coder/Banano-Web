---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Dashboard/Header.astro";
import Sidebar from "../../components/Dashboard/Sidebar.astro";
import Footer from "../../components/Dashboard/Footer.astro";
import { ReportsDashboard } from "../../components/Dashboard/Inventory/ReportsDashboard";
import { AuthGuard } from "../../components/Dashboard/AuthGuard";
---

<Layout title="Reportes - Panel Administrativo">
  <div class="flex flex-col min-h-screen bg-background bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]">
    <Header />
    <div class="flex flex-1">
      <Sidebar />
      <main class="flex-1 min-w-0 p-6 md:p-8">
        <AuthGuard client:load allowedRoles={['admin', 'manager', 'vendedor', 'viewer']} panelName="Reportes">
          <div class="space-y-6">
            <div>
              <h1 class="text-3xl font-bold tracking-tight text-foreground drop-shadow-sm font-outfit">Centro de Reportes</h1>
              <p class="text-foreground/70 font-medium">Analiza y exporta informes sobre el inventario, ventas y el margen de ganancia operativa.</p>
            </div>
            <ReportsDashboard client:load />
          </div>
        </AuthGuard>
      </main>
    </div>
    <Footer />
  </div>
</Layout>
