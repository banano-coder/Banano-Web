---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Dashboard/Header.astro";
import Sidebar from "../../components/Dashboard/Sidebar.astro";
import { OrdersManager } from "../../components/Dashboard/Orders/OrdersManager";
import { AuthGuard } from "../../components/Dashboard/AuthGuard";

// Protect route (check for token) - Middleware usually handles this, but good to ensure
const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/login");
}
---

<Layout title="Gestión de Pedidos - Banano Shop">
  <div class="flex flex-col min-h-screen bg-background bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]">
    <Header />
    <div class="flex flex-1">
      <Sidebar />
      <main class="flex-1 min-w-0 p-6 md:p-8">
        <AuthGuard client:load allowedRoles={['admin', 'manager', 'vendedor']} panelName="Pedidos">
          <OrdersManager client:only="react" />  
        </AuthGuard>
      </main>
    </div>
  </div>
</Layout>
