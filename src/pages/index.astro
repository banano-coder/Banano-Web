---
import Layout from "../layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { ProductGrid } from "@/components/Shop/ProductGrid";
import { CartWidget } from "@/components/Shop/CartWidget";
import { CartDrawer } from "@/components/Shop/CartDrawer";
import { LogIn } from 'lucide-react';
---

<Layout title="Banano Shop">
  <!-- Interactive Elements (Islands) -->
  <CartWidget client:load />
  <CartDrawer client:load />

  <main class="flex-1 bg-background min-h-screen text-foreground bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]">
    <!-- Hero / Header Section -->
    <header class="container px-4 py-8 flex justify-between items-center border-b border-border">
      <div class="flex items-center space-x-2">
         <span class="text-3xl">🍌</span>
         <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary via-secondary to-accent">Banano Shop</h1>
      </div>
      
      <div class="flex items-center space-x-4">
        <!-- Login Button -->
        <a
          href="/login"
          class={cn(buttonVariants({ variant: "outline" }), "border-primary text-primary hover:bg-primary hover:text-primary-foreground transition-colors font-semibold")}
        >
          <LogIn className="mr-2 h-4 w-4" /> Login
        </a>
      </div>
    </header>

    <!-- Hero Banner -->
    <section class="py-12 md:py-20 text-center container px-4">
      <h2 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight">
        Deliciosos <span class="text-primary">Bananos</span> Frescos
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto mb-8">
        La mejor selección de productos derivados del banano, entregados directamente a tu puerta. Frescura garantizada y sabor inigualable.
      </p>
    </section>

    <!-- Product Grid -->
    <section class="container px-4 pb-20">
      <ProductGrid client:load />
    </section>
  </main>
</Layout>