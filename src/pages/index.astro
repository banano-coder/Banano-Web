---
import Layout from "../layouts/Layout.astro";
import { ProductGrid } from "@/components/Shop/ProductGrid";
import { CartWidget } from "@/components/Shop/CartWidget";
import { CartDrawer } from "@/components/Shop/CartDrawer";
import { LogIn, MapPin } from 'lucide-react';
import { FloatingHomeButton } from "@/components/Common/FloatingHomeButton";

const externalApiBase = import.meta.env.PUBLIC_EXTERNAL_API_BASE;
let settings: any = {};

try {
    const response = await fetch(`${externalApiBase}/public/settings`);
    if (response.ok) {
        settings = await response.json();
    }
} catch (e) {
    console.error("Error fetching settings for index.astro:", e);
}

const tienda = settings.tienda || {};
const title = tienda.nombre || "Banano Shop";
const heroTitle = tienda.hero_titulo || "BANANO SEXSHOP";
const [heroTitleFirst, ...heroTitleRest] = heroTitle.split(" ");
const heroTitleRemaining = heroTitleRest.join(" ");
---

<Layout title={title}>
  <!-- Interactive Elements (Islands) -->
  <CartWidget client:load />
  <CartDrawer client:load />
  <FloatingHomeButton client:load />

  <main class="flex flex-col min-h-screen bg-background text-foreground bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]">
    
    <!-- Light Pink Top Wrapper -->
    <div class="bg-[#ffcce6] text-[#df0067] relative pb-32">
      <!-- Header Section -->
      <header class="container px-4 py-2.5 sm:py-4 flex justify-between items-center border-b border-[#df0067]/10">
        <a href="/" class="flex items-center space-x-1.5 hover:opacity-90 transition-opacity">
           <img src="/logo_original.png" class="h-6 sm:h-8 md:h-10 w-auto" alt="Logo" />
            <h1 class="text-base sm:text-xl md:text-2xl font-extrabold text-[#df0067] tracking-tight whitespace-nowrap">{title}</h1>
        </a>
        
        <div class="flex items-center space-x-4">
          <a
            href="/login"
            class="px-2.5 py-1 sm:px-4 sm:py-1.5 border sm:border-2 border-[#df0067] text-[#df0067] hover:bg-[#df0067] hover:text-white transition-all rounded-full font-bold text-[10px] sm:text-xs md:text-sm tracking-wide whitespace-nowrap flex items-center gap-1"
          >
            <LogIn className="h-3 w-3 sm:h-3.5 sm:w-3.5 md:h-4 md:w-4" /> Iniciar Sesión
          </a>
        </div>
      </header>

      <div class="flex-1">
        <!-- Hero Banner -->
        <section class="py-12 md:py-24 text-center container px-4 relative z-10">
          <h2 class="font-normal mb-8 text-[#df0067] drop-shadow-sm flex flex-col items-center justify-center gap-0">
            <img 
              src="/logo_original.png" 
              class="h-32 w-auto md:h-48 object-contain drop-shadow-[0_10px_20px_rgba(223,0,103,0.3)] animate-float hover:rotate-6 hover:scale-105 transition-transform duration-300 select-none mb-4" 
              alt="Banana Logo" 
            />
            <span class="text-7xl md:text-[9rem] leading-none tracking-tighter font-gliker uppercase">{heroTitleFirst}</span>
            {heroTitleRemaining && (
              <span class="text-3xl md:text-5xl font-sans font-medium tracking-[0.2em] mt-2 uppercase">{heroTitleRemaining}</span>
            )}
          </h2>
          <p class="text-[#df0067]/90 text-xl md:text-2xl max-w-2xl mx-auto mb-12 font-medium">
            {tienda.hero_descripcion || "La mejor selección de productos íntimos."}
          </p>
        </section>
      </div>

      <!-- Background Gradient Fusion (Smoother) -->
      <div class="absolute bottom-0 left-0 w-full h-[500px] bg-gradient-to-t from-background via-background/80 to-transparent translate-y-[20%] pointer-events-none"></div>
    </div>

    <!-- Product Grid Section -->
    <section class="container px-4 pb-20 relative z-20 mt-[-80px]">
      <ProductGrid client:load />
    </section>

    <!-- Footer Section -->
    <footer class="border-t border-border bg-card/50 backdrop-blur-sm py-12">
        <div class="container px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-8 text-center md:text-left">
                <div class="space-y-4 max-w-sm">
                    <div class="flex items-center justify-center md:justify-start gap-2">
                        <img src="/logo_original.png" class="h-8 w-auto" alt="Logo" />
                        <h3 class="text-2xl font-bold text-primary">{title}</h3>
                    </div>
                </div>

                {tienda.mostrar_info && (
                    <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
                        {tienda.direccion && (
                            <div class="flex flex-col items-center md:items-start gap-1 max-w-xs">
                                <div class="flex items-center gap-2 text-primary font-bold uppercase tracking-tight text-[10px]">
                                    <MapPin className="h-3 w-3" />
                                    Dirección
                                </div>
                                <p class="text-xs text-foreground bg-primary/5 p-2 rounded-lg border border-primary/10 shadow-sm text-center md:text-left">
                                    {tienda.direccion}
                                </p>
                            </div>
                        )}

                        {(tienda.telefono || tienda.email_contacto) && (
                            <div class="space-y-3 flex flex-col items-center md:items-start">
                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest">Contacto</p>
                                <div class="space-y-1 text-center md:text-left">
                                    {tienda.telefono && <p class="text-sm font-bold text-primary">{tienda.telefono}</p>}
                                    {tienda.email_contacto && <p class="text-xs font-medium text-muted-foreground">{tienda.email_contacto}</p>}
                                </div>
                            </div>
                        )}
                    </div>
                )}
            </div>
            <div class="mt-12 pt-8 border-t border-border text-center">
                <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-[0.2em]">
                    &copy; {new Date().getFullYear()} {title} - Todos los derechos reservados.
                </p>
            </div>
        </div>
    </footer>
  </main>
</Layout>

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(2deg);
    }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
</style>
