---
import { 
    Home, 
    Users, 
    ShoppingCart, 
    Package, 
    Warehouse, 
    BarChart3, 
    ClipboardList, 
    Wallet, 
    Receipt, 
    CreditCard, 
    ShieldCheck, 
    Settings 
} from 'lucide-react';

const { pathname } = Astro.url;
const isActive = (path: string) => {
    // Exact match or match with trailing slash
    return pathname === path || pathname === path + '/';
};

const navItems = [
    { name: 'Principal', path: '/dashboard', icon: Home, color: 'text-blue-500' },
    { name: 'Usuarios', path: '/dashboard/users', icon: Users, color: 'text-purple-500' },
    { name: 'Ventas', path: '/dashboard/sales', icon: ShoppingCart, color: 'text-green-500' },
    { name: 'Inventario', path: '/dashboard/products', icon: Package, color: 'text-orange-500' },
    { name: 'Almacenes', path: '/dashboard/almacenes', icon: Warehouse, color: 'text-amber-600' },
    { name: 'Reportes', path: '/dashboard/reports', icon: BarChart3, color: 'text-indigo-500' },
    { name: 'Pedidos', path: '/dashboard/orders', icon: ClipboardList, color: 'text-pink-500' },
    { name: 'Dinero y Caja', path: '/dashboard/money', icon: Wallet, color: 'text-emerald-500' },
    { name: 'Gastos', path: '/dashboard/expenses', icon: Receipt, color: 'text-red-500' },
    { name: 'Cashea', path: '/dashboard/cashea', icon: CreditCard, color: 'text-sky-500' },
    { name: 'Auditoría', path: '/dashboard/audit', icon: ShieldCheck, color: 'text-slate-500' },
    { name: 'Configuración', path: '/dashboard/settings', icon: Settings, color: 'text-gray-500' },
];
---
<!-- Mobile Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>

<aside 
    id="dashboard-sidebar" 
    class="fixed md:static inset-y-0 left-0 w-64 p-4 bg-card/95 md:bg-card/80 backdrop-blur-md border-r border-border z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl md:shadow-none"
>
    <div class="flex items-center justify-between mb-6 md:hidden">
        <span class="font-bold text-primary">Navegación</span>
        <button id="close-sidebar" class="p-1 hover:bg-secondary rounded">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>
    <nav>
        <ul class="space-y-1">
            {navItems.map((item) => {
                const Icon = item.icon;
                const active = isActive(item.path);
                return (
                    <li>
                        <a 
                            href={item.path} 
                            class={`flex items-center gap-3 px-4 py-2.5 rounded-md transition-all duration-200 ${
                                active 
                                ? 'bg-primary text-primary-foreground font-bold shadow-md' 
                                : 'text-foreground hover:bg-secondary hover:translate-x-1'
                            }`}
                        >
                            <Icon className={`w-5 h-5 ${active ? 'text-primary-foreground' : item.color}`} />
                            <span class="text-sm">{item.name}</span>
                        </a>
                    </li>
                );
            })}
        </ul>
    </nav>
</aside>

<script>
    const closeBtn = document.getElementById('close-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const sidebar = document.getElementById('dashboard-sidebar');

    const closeSidebar = () => {
        if (sidebar) sidebar.classList.add('-translate-x-full');
        if (overlay) overlay.classList.add('hidden');
    };

    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);
</script>